# コピーして .env を作成。秘密値をGitやDockerイメージに含めないこと。
DISCORD_BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
DISCORD_APPLICATION_ID=000000000000000000
# このサーバー内の全チャンネルが対象（チャンネル単位の絞り込みは廃止済み）
GUILD_ID=000000000000000000

# /chat/completions を除いたAPIベースURL。HTTPS、またはループバック・RFC1918宛のHTTP。
# 例: http://192.168.0.123:8080/v1（10/8、172.16/12、192.168/16を許可）。
LLM_BASE_URL=http://127.0.0.1:11435/v1
LLM_API_KEY=
# Mistralを使う場合はキーを設定。設定すると上のLLM設定より優先して自動切替。
# Mistral利用時は複数リクエストを並列処理する。
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# ローカル推論サーバーに導入済みのモデルIDだけを指定（未導入のIDを足しても取り込みは自動で始まらない）。
# 現在このホストに入っているのは次の5つだけ。認証不要のため API_KEY は空欄のまま。
#   hf.co/unsloth/Qwen3.8-27B-GGUF:Q4_K_S
#   hf.co/chimingw/Qwen3.8-27B-Uncensored-OrcaRouter-GGUF:Q4_K_M
#   hf.co/LiquidAI/LFM2.5-24B-A2B-GGUF:Q4_K_M
#   hf.co/unsloth/gemma-4-26B-A4B-it-GGUF:UD-Q4_K_M
#   hf.co/unsloth/Qwen3.6-35B-A3B-MTP-GGUF:UD-Q3_K_XL
LLM_MODEL=YOUR_LOCAL_CHAT_MODEL
LLM_TEMPERATURE=0.7
# コード用の出力枠を含む。Botは少なくとも MAX_CODE_TOKENS + 2048 を確保する。
LLM_MAX_TOKENS=10240
# DiscordではSSEで受信し、同じ返信を編集して途中経過を表示。
LLM_STREAM_ENABLED=true
LLM_FIRST_TOKEN_TIMEOUT_SECONDS=300
# ストリーム中は無応答の上限。Embedding・非ストリームHTTPでは総時間の上限。
LLM_TIMEOUT_SECONDS=90
LLM_STREAM_TIMEOUT_SECONDS=900
# 返信チェーン取得・RAG・複数のLLM/ツール往復を含む実行上限。キュー待ちは含めない。
REQUEST_TIMEOUT_SECONDS=1200

# 空欄ならLLMと同じURL/キー。Embedding は compose の embedding サービス（127.0.0.1:11434）へだけ向ける。
# MEMORY_ENABLED=false の場合は Embedding 設定は不要。
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_API_KEY=
# ビルド時にHFから取得。トークンはBuildKit secretで渡し、イメージに保存しない。
HF_TOKEN=
# EmbeddingGemma 2（CPUのみ、768次元）。
EMBEDDING_MODEL=embeddinggemma-2
EMBEDDING_DIMENSION=768
MEMORY_ENABLED=true
DATA_DIR=./data
RETRIEVAL_MIN_SCORE=0.35
RETRIEVAL_TOP_K=8
INGEST_MAX_CHARS_PER_DOC=12000
INGEST_CHUNK_SIZE=900
INGEST_CHUNK_OVERLAP=150

# 検索・URL本文取得のMCP。EXA_API_KEYを設定すると両方が利用可能。
EXA_API_KEY=
# Exa未設定時のみ使う従来の検索キー（任意）。Exa失敗時の自動切替はしない。
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_FETCH_ENABLED=true
WEB_FETCH_MAX_CHARS=12000

# 音声添付・VC文字起こしを使う場合はtrue。uv sync --extra voice が必要。モデルは初回起動時にHFから取得。
ASR_ENABLED=false
ASR_MODEL_PATH=./data/asr-model
ASR_MODEL=Systran/faster-whisper-small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=ja
ASR_CPU_THREADS=8
ASR_WORKERS=2

# VC内の合言葉に続く質問へ通常回答し、その回答をTTSで読む（空なら無効）。
VC_TTS_TRIGGER=
VC_TTS_VOICE=ja-JP-NanamiNeural

AUDIT_LOG_ENABLED=true
MAX_OUTPUT_CHARS=1800
# コード本体は説明文の文字数上限から分離。複数ブロックの合計トークン枠。
MAX_CODE_TOKENS=8192

# Web UIはデフォルト有効、認証不要。無効にする場合はHTTP_ENABLED=false。
HTTP_ENABLED=true
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
