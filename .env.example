# コピーして .env を作成。秘密値をGitやDockerイメージに含めないこと。
DISCORD_BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
DISCORD_APPLICATION_ID=000000000000000000
# このサーバー内の全チャンネルが対象（チャンネル単位の絞り込みは廃止済み）
GUILD_ID=000000000000000000

# /chat/completions を除いたAPIベースURL。HTTPSは常時可。平文HTTPは社内・ローカル範囲のみ可:
# RFC1918(10/8, 172.16/12, 192.168/16), loopback(127/8, ::1), link-local(169.254/16, fe80::/10),
# CGNAT(100.64/10), 一意ローカルIPv6(fc00::/7)。試験用・予約済み・グローバル地址への平文は設定時点で拒否。
# Dockerからホストの推論サーバーへ接続: http://host.docker.internal:11434/v1
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=
# ローカル推論サーバーに導入したモデルIDを指定。認証不要ならAPI_KEYは空欄。
LLM_MODEL=YOUR_LOCAL_CHAT_MODEL
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=90

# 空欄ならLLMと同じURL/キー。Embeddingは導入済みのモデルを指定（既定: gemma2）。
# MEMORY_ENABLED=false の場合は Embedding 設定は不要。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemma2
EMBEDDING_DIMENSION=3072
MEMORY_ENABLED=true
DATA_DIR=./data
RETRIEVAL_MIN_SCORE=0.35
RETRIEVAL_TOP_K=8
INGEST_MAX_CHARS_PER_DOC=12000
INGEST_CHUNK_SIZE=900
INGEST_CHUNK_OVERLAP=150

# Tavilyキーがなければ検索ツール自体を無効化
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5

# 任意。uv sync --extra asr とローカルCT2モデルが必要。
ASR_ENABLED=false
ASR_MODEL_PATH=./data/asr-model
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=ja

AUDIT_LOG_ENABLED=true
MAX_OUTPUT_CHARS=1800

# ローカル運用画面。通常は不要。両方の認証値がなければ画面・メトリクスは404。
HTTP_ENABLED=false
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
